# ==============================================================================
# CauseConnect AI — Environment Variable Configuration
# Copy this file to .env (or .env.local) and populate with your environment values.
# NEVER commit secret keys or tokens into version control.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Frontend Backend API URL (for standalone frontend deployment e.g. on Vercel)
# Leave empty or set to / when running full-stack under server.ts
VITE_API_BASE_URL=""

# Supabase Authentication & Database Persistence
# Required for both frontend and backend operations
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# Backend-only Service Role Key (Keep strictly server-side, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Frontend Supabase Client Variables
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Playwright Browser Automation
# Playwright uses locally installed Chromium binary; no third-party API key required.
# In Docker/Cloud environments, system browser dependencies are handled via Dockerfile.
